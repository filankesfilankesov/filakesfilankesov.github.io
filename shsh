<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Turgut Dalcalı — Mimar — Özgeçmiş</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900&family=JetBrains+Mono:wght@400;500;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --blue-deep:#0E2B47;
    --blue-mid:#154272;
    --blue-line:#9FC3E6;
    --blue-line-soft:rgba(159,195,230,0.35);
    --paper:#F6F8FA;
    --paper-white:#FFFFFF;
    --ink:#15222E;
    --ink-soft:#4B5C6B;
    --tape:#E8A33D;
    --tape-soft:#F2C87A;
    --graphite:#7A8B9A;
    --rule:#C7D6E2;
  }

  *{box-sizing:border-box;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  html{scroll-behavior:smooth;}

  body{
    margin:0;
    padding:36px 18px 60px;
    background:
      linear-gradient(var(--blue-line-soft) 1px, transparent 1px) 0 0/28px 28px,
      linear-gradient(90deg, var(--blue-line-soft) 1px, transparent 1px) 0 0/28px 28px,
      var(--blue-deep);
    font-family:'Work Sans', sans-serif;
    color:var(--ink);
    display:flex;
    justify-content:center;
  }

  .sheet{
    position:relative;
    width:100%;
    max-width:1180px;
    background:var(--paper-white);
    border:2px solid var(--blue-deep);
    outline:1px solid var(--blue-deep);
    outline-offset:6px;
    box-shadow:0 30px 70px rgba(0,0,0,0.35);
  }

  /* corner crop marks, like a drawing sheet trim */
  .crop{position:absolute; width:20px; height:20px; z-index:5;}
  .crop::before,.crop::after{content:"";position:absolute;background:var(--blue-deep);}
  .crop::before{width:20px;height:2px;top:0;left:0;}
  .crop::after{width:2px;height:20px;top:0;left:0;}
  .crop.tl{top:-14px; left:-14px;}
  .crop.tr{top:-14px; right:-14px; transform:scaleX(-1);}
  .crop.bl{bottom:-14px; left:-14px; transform:scaleY(-1);}
  .crop.br{bottom:-14px; right:-14px; transform:scale(-1,-1);}

  /* ============ HEADER / TITLE STRIP ============ */
  .head{
    display:grid;
    grid-template-columns:150px 1fr 300px;
    gap:28px;
    align-items:center;
    padding:34px 40px;
    border-bottom:3px solid var(--blue-deep);
    background:
      repeating-linear-gradient(135deg, rgba(14,43,71,0.035) 0 2px, transparent 2px 14px);
  }

  .photo-wrap{
    width:150px;height:150px;border-radius:50%;
    padding:5px;
    border:2px dashed var(--rule);
    display:flex;align-items:center;justify-content:center;
    animation:draw-in 900ms ease-out;
  }
  .photo-wrap img{
    width:100%;height:100%;object-fit:cover;border-radius:50%;
    filter:grayscale(18%) contrast(1.03);
    border:3px solid var(--blue-deep);
  }

  .name-block .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:11px; letter-spacing:.22em; color:var(--tape);
    text-transform:uppercase; margin:0 0 6px;
  }
  .name-block h1{
    font-family:'Big Shoulders Display', sans-serif;
    font-weight:900;
    font-size:clamp(38px, 5vw, 58px);
    line-height:0.92;
    letter-spacing:.01em;
    margin:0 0 10px;
    color:var(--blue-deep);
    text-transform:uppercase;
  }
  .name-block .role{
    font-family:'JetBrains Mono', monospace;
    font-size:14px; letter-spacing:.3em; text-transform:uppercase;
    color:var(--ink-soft);
    padding-left:2px;
    position:relative;
  }
  .name-block .role::before{
    content:"";
    display:inline-block; width:26px; height:1px;
    background:var(--tape); margin-right:10px; vertical-align:middle;
  }

  .meta{
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    display:flex; flex-direction:column; gap:9px;
    border-left:1px solid var(--rule);
    padding-left:22px;
  }
  .meta .row{display:flex; justify-content:space-between; gap:10px; color:var(--ink-soft);}
  .meta .row b{color:var(--ink); font-weight:500; text-align:right;}
  .meta .row span:first-child{color:var(--graphite); letter-spacing:.05em;}

  /* dimension-line divider with tick marks, referencing drafting scale notation */
  .dim{
    display:flex; align-items:center; gap:10px;
    padding:8px 40px;
    background:var(--blue-deep);
    color:var(--blue-line);
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px; letter-spacing:.18em; text-transform:uppercase;
  }
  .dim::before,.dim::after{content:"";flex:1;height:0; border-top:1px dashed var(--blue-line-soft);}
  .dim span{white-space:nowrap; opacity:.85;}

  /* ============ MAIN GRID ============ */
  .body-grid{
    display:grid;
    grid-template-columns:1.55fr 1fr;
  }

  .col-left{
    padding:36px 40px 40px;
    border-right:2px solid var(--blue-deep);
  }
  .col-right{
    background:
      linear-gradient(var(--blue-line-soft) 1px, transparent 1px) 0 0/22px 22px,
      linear-gradient(90deg, var(--blue-line-soft) 1px, transparent 1px) 0 0/22px 22px,
      var(--blue-mid);
    color:var(--blue-line);
    padding:36px 34px 40px;
  }

  .sheet-block{margin-bottom:34px;}
  .sheet-block:last-child{margin-bottom:0;}

  .sheet-tag{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace;
    font-size:11px; font-weight:700; letter-spacing:.12em;
    color:var(--tape);
    background:rgba(232,163,61,0.1);
    border:1px solid rgba(232,163,61,0.4);
    padding:3px 9px;
    margin-bottom:10px;
  }
  .col-right .sheet-tag{
    color:var(--tape-soft);
    background:rgba(232,163,61,0.12);
    border-color:rgba(232,163,61,0.4);
  }

  .sheet-block h2{
    font-family:'Big Shoulders Display', sans-serif;
    font-weight:700;
    font-size:26px;
    letter-spacing:.02em;
    text-transform:uppercase;
    margin:0 0 16px;
    color:var(--blue-deep);
    border-bottom:1.5px solid var(--blue-deep);
    padding-bottom:8px;
  }
  .col-right .sheet-block h2{
    color:var(--paper-white);
    border-bottom:1.5px solid var(--blue-line-soft);
  }

  .entry{margin-bottom:18px; position:relative; padding-left:16px;}
  .entry:last-child{margin-bottom:0;}
  .entry::before{
    content:""; position:absolute; left:0; top:6px;
    width:7px; height:7px; border:1.5px solid var(--tape);
    transform:rotate(45deg);
  }
  .entry .title{font-weight:600; font-size:15px; color:var(--ink); margin:0 0 2px;}
  .entry .org{font-size:13px; color:var(--ink-soft); margin:0 0 2px;}
  .entry .date{
    font-family:'JetBrains Mono', monospace;
    font-size:11px; color:var(--graphite); letter-spacing:.04em;
  }
  .entry .desc{font-size:13px; color:var(--ink-soft); margin-top:4px; line-height:1.5;}
  .entry .desc i{font-weight:600; color:var(--ink); font-style:normal;}

  /* ============ RULER-STYLE SKILL BARS ============ */
  .skill{margin-bottom:16px;}
  .skill:last-child{margin-bottom:0;}
  .skill-label{
    display:flex; justify-content:space-between; align-items:baseline;
    font-family:'JetBrains Mono', monospace;
    font-size:11.5px; letter-spacing:.06em;
    margin-bottom:6px; color:var(--blue-line);
  }
  .ruler{
    position:relative; height:12px;
    background:repeating-linear-gradient(90deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 10%);
    border:1px solid rgba(255,255,255,0.3);
  }
  .ruler .fill{
    position:absolute; top:0; left:0; bottom:0;
    background:linear-gradient(90deg, var(--tape), var(--tape-soft));
    width:0%;
    animation:fill-in 1200ms ease-out forwards;
  }

  /* language table styled like a drawing legend/schedule */
  .lang-table{
    width:100%; border-collapse:collapse;
    font-family:'JetBrains Mono', monospace;
    font-size:12px;
  }
  .lang-table th{
    text-align:left; font-weight:500; text-transform:uppercase;
    letter-spacing:.08em; font-size:10px; color:var(--blue-line);
    border-bottom:1px solid rgba(255,255,255,0.35);
    padding:0 6px 8px;
  }
  .lang-table th:not(:first-child), .lang-table td:not(:first-child){text-align:center;}
  .lang-table td{
    padding:9px 6px; border-bottom:1px solid rgba(255,255,255,0.15);
    color:var(--paper-white);
  }
  .lang-table td:first-child{color:var(--tape-soft); font-weight:700;}

  .tags{display:flex; flex-wrap:wrap; gap:8px;}
  .tags span{
    font-family:'JetBrains Mono', monospace;
    font-size:11px; letter-spacing:.03em;
    border:1px solid rgba(255,255,255,0.4);
    padding:5px 10px;
    color:var(--paper-white);
  }

  /* small compass rose — signature architectural motif */
  .compass{
    width:64px; height:64px; margin:0 auto 22px;
    position:relative;
  }
  .compass svg{width:100%; height:100%;}

  /* ============ TITLE BLOCK FOOTER ============ */
  .titleblock{
    border-top:3px solid var(--blue-deep);
    display:grid;
    grid-template-columns:repeat(5,1fr);
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px;
    background:var(--paper);
  }
  .titleblock div{
    padding:12px 16px;
    border-right:1px solid var(--rule);
  }
  .titleblock div:last-child{border-right:none;}
  .titleblock .k{color:var(--graphite); letter-spacing:.12em; text-transform:uppercase; margin-bottom:4px;}
  .titleblock .v{color:var(--blue-deep); font-weight:700; font-size:12px;}

  @keyframes draw-in{
    from{clip-path:circle(0% at 50% 50%); opacity:0;}
    to{clip-path:circle(75% at 50% 50%); opacity:1;}
  }
  @keyframes fill-in{
    from{width:0%;}
  }

  /* per-skill widths (set inline via style attr in markup) */

  @media (max-width: 860px){
    .head{grid-template-columns:1fr; text-align:center;}
    .meta{border-left:none; border-top:1px solid var(--rule); padding-left:0; padding-top:16px;}
    .meta .row{justify-content:center; gap:14px;}
    .photo-wrap{margin:0 auto;}
    .body-grid{grid-template-columns:1fr;}
    .col-left{border-right:none; border-bottom:2px solid var(--blue-deep);}
    .titleblock{grid-template-columns:1fr 1fr;}
    .titleblock div{border-bottom:1px solid var(--rule);}
  }

  @media print{
    body{background:white; padding:0;}
    .sheet{box-shadow:none; outline:none; border:none; max-width:100%;}
  }
</style>
</head>
